# Configuración del API Gateway Tuya Go - siguiendo el patrón del SDK oficial
# Equivalente a config.SetEnv() del SDK oficial

# Credenciales de Tuya Cloud - requeridas para token.GetTokenAPI()
TUYA_ACCESS_ID=your_access_id_here
TUYA_ACCESS_KEY=your_access_key_here

# URL de la API de Tuya - usar según tu región
# US: https://openapi.tuyaus.com
# EU: https://openapi.tuyaeu.com  
# CN: https://openapi.tuyacn.com
# IN: https://openapi.tuyain.com

TUYA_API_URL=https://openapi-ueaz.tuyaus.com

# Puerto de la aplicación (opcional)
PORT=8080

# Configuración de Gin (opcional)
GIN_MODE=debug 